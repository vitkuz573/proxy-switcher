{
  "name": "proxy-switcher",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm --filter @proxy-switcher/sdk build && pnpm --filter @proxy-switcher/api build",
    "ci": "./scripts/ci.sh",
    "dev": "pnpm --parallel --filter \"./api\" --filter \"./web\" dev",
    "engine:build": "cargo build --release --workspace",
    "engine:lint": "cargo clippy --workspace -- -D warnings",
    "engine:test": "cargo test --workspace",
    "format": "biome format --write .",
    "lint": "biome check .",
    "sdk:generate": "pnpm --filter \"./api\" sdk:generate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
