# Copy to .env and adjust. Never commit real values.

# ── API service ───────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8088

# Internal Rust engine. Must stay on loopback.
ENGINE_URL=http://127.0.0.1:9099
ENGINE_TIMEOUT_MS=15000

# Auth database (separate from the engine's own proxy store).
DATABASE_PATH=/var/lib/proxy-switcher/auth.db

# Signing key for session cookies. Minimum 32 chars. Required in production.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# First-run administrator, applied only while the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

SESSION_TTL_HOURS=24
API_TOKEN_TTL_DAYS=90

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://127.0.0.1:3000

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

LOG_LEVEL=info

# ── Web app ───────────────────────────────────────────────────────────────



# Server-only URL. Use this for SSR fetches so the app can reach the API
# without going through the public hostname.
API_INTERNAL_URL=http://127.0.0.1:8088